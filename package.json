{
  "name": "dsh-plugin-live2d-stage",
  "version": "0.5.3",
  "type": "module",
  "description": "DSHLive2D — DeepSeek Harness Live2D 桌面角色、动作预览与 Agent 动作控制",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib/index.mjs",
    "lib/store.cjs",
    "lib/client.js",
    "lib/floating.mjs",
    "lib/chat.mjs",
    "lib/native",
    "assets",
    "licenses",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "character"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "build:native": "powershell -NoProfile -File native/build.ps1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "icon": "./assets/icon.webp",
  "author": {
    "name": "小红书号 4190947207 (B612plant)",
    "url": "https://github.com/B612plant"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B612plant/dsh-plugin-live2d-stage.git"
  },
  "homepage": "https://github.com/B612plant/dsh-plugin-live2d-stage",
  "bugs": {
    "url": "https://github.com/B612plant/dsh-plugin-live2d-stage/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "live2d",
    "dshlive2d",
    "desktop"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "playwright": "1.63.0-alpha-2026-08-31",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "unzipper": "0.12.5"
  }
}
